{
  "name": "app",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.json",
    "check:watch": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "deploy": "bash scripts/install-app.sh && bun run sweep-targets",
    "sweep-targets": "cargo sweep --time 7 src-tauri",
    "lint": "node scripts/lint-ratchet.mjs",
    "lint:full": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:baseline": "node scripts/lint-ratchet.mjs --update",
    "lint:ratchet-down": "node scripts/lint-ratchet.mjs --ratchet-down",
    "format": "prettier --write \"src/**/*.{js,ts,tsx,svelte,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,tsx,svelte,css,json}\"",
    "prepare": "husky"
  },
  "license": "MIT",
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@daypicker/react": "^10.0.2",
    "@lhak/style": "file:./vendor/lhak-style",
    "@number-flow/react": "0.6.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.4.0",
  "lint-staged": {
    "*.{js,ts,tsx,svelte,css,json}": [
      "prettier --write"
    ],
    "*.{js,ts,tsx,svelte}": [
      "eslint --fix"
    ]
  }
}
