{
  "name": "app",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "deploy": "bash scripts/install-app.sh && bun run sweep-targets",
    "sweep-targets": "cargo sweep --time 7 src-tauri",
    "lint": "node scripts/lint-ratchet.mjs",
    "lint:full": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:baseline": "node scripts/lint-ratchet.mjs --update",
    "lint:ratchet-down": "node scripts/lint-ratchet.mjs --ratchet-down",
    "format": "prettier --write \"src/**/*.{js,ts,svelte,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,svelte,css,json}\"",
    "prepare": "husky"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-svelte": "^1.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.4.0",
  "lint-staged": {
    "*.{js,ts,svelte,css,json}": [
      "prettier --write"
    ],
    "*.{js,ts,svelte}": [
      "eslint --fix"
    ]
  }
}
