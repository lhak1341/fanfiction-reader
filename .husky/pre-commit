bunx lint-staged

# Lower .lint-baseline.json when a commit removes warnings, so CI (which fails on a drop)
# sees the new count. Skipped when no JS/TS/Svelte file is staged.
if git diff --cached --name-only | grep -qE '\.(js|ts|svelte)$'; then
  bun run lint:ratchet-down && git add .lint-baseline.json
fi
